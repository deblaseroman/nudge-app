%% commit ede6774 · state machine: the Live Activity (Activity of TaskActivityAttributes). States are SessionState cases; .timeUp is never written, the widget derives it from isStale. One arrow per pair of states, labeled with the main function. Thick arrow = done outside the app, no app code runs.
flowchart TB
  A_NONE(["LiveActivityManager.swift<br/>currentActivity = nil"])
  A_ACTIVE(["TaskActivityAttributes.swift<br/>SessionState.active"])
  A_ALERT(["TaskActivityAttributes.swift<br/>SessionState.stayFocusedAlert"])
  A_TIMEUP(["TaskActivityAttributes.swift<br/>SessionState.timeUp"])
  A_COMPLETE(["TaskActivityAttributes.swift<br/>SessionState.complete"])

  A_NONE -- "startActivity" --> A_ACTIVE
  A_ACTIVE -- "showStayFocusedAlert" --> A_ALERT
  A_ALERT -- "revertToActive" --> A_ACTIVE
  A_ACTIVE -- "displayState" --> A_TIMEUP
  A_ALERT -- "displayState" --> A_TIMEUP
  A_ACTIVE -- "endActivity" --> A_COMPLETE
  A_ALERT -- "endActivity" --> A_COMPLETE
  A_TIMEUP -- "endActivity" --> A_COMPLETE
  A_COMPLETE -- "endActivity, .immediate" --> A_NONE
  A_TIMEUP -- "EndFocusSessionIntent.perform" --> A_NONE
  A_ACTIVE == "removed outside the app" ==> A_NONE

