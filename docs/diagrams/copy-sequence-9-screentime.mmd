%% commit ede6774 · stage 9: the Screen Time extension. iOS calls eventDidReachThreshold; the mirror event posts one fixed pair of strings, a limit event posts the pair LimitDecider picks. The strings are a table on the page.
sequenceDiagram
  autonumber
  box rgba(14,111,111,0.10) App code
    participant EXT as DeviceActivityMonitorExtension.swift<br/>eventDidReachThreshold
    participant KEYS as Screen Time keys<br/>DistractionSettings.swift
    participant DECIDE as DistractionSettings.swift<br/>LimitDecider.decide
    participant TEXT as DistractionSettings.swift<br/>LimitDecision.placeholderTitle
  end
  box rgba(93,100,113,0.16) OS framework
    participant UNC as UserNotifications<br/>UNUserNotificationCenter
  end
  EXT->>KEYS: read settings
  alt event is nudge.mirror
    EXT->>KEYS: write mirrorLastFiredAt
    EXT->>UNC: post MIRROR request
  else a limit event
    EXT->>KEYS: read snapshot, rung stamp
    EXT->>DECIDE: decide
    DECIDE-->>EXT: returns LimitDecision
    EXT->>KEYS: write rung stamp
    EXT->>TEXT: placeholderTitle, placeholderBody
    TEXT-->>EXT: returns title, body
    EXT->>UNC: post limit request
  end
