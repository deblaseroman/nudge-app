%% Nudge task lifecycle at commit ede6774 (2026-10-05). The complete reference; the page renders an overview plus close-ups cut from this.
%% The persisted model is NudgeTask (Nudge/Models/NudgeTask.swift). Lifecycle fields: isInformationalEvent, dueDate / dueTime / specificTime (the owed clock), intendedDate (the plan day), plannedStartDate / plannedDurationMinutes / plannedIsAuto (the plan time), planDayIsAuto, sequenceIndex, skipCount, isComplete / completedAt. CompletedTaskRecord is the completion log.
%% Stadium boxes are states (field values, file). Square boxes are file + function. Every arrow is a call, read or write found in code; labels name the function or the condition.
%% Dashed (class dead) = exists but has no effect on the store: DEBUG-only harnesses, a one-shot backfill, an unread column.
flowchart LR

subgraph STATES ["NudgeTask row states · Nudge/Models/NudgeTask.swift"]
  S_NEW(["no row yet"])
  S_UNPLANNED(["open · intendedDate nil · plannedStartDate nil<br/>lists: Unscheduled; Today when owed today; Overdue once sortDeadline passes"])
  S_DAY(["open · intendedDate set · plannedStartDate nil<br/>lists: that day's lens"])
  S_AUTO(["open · plannedStartDate set · plannedIsAuto true<br/>today's timeline, movable"])
  S_MANUAL(["open · plannedStartDate set · plannedIsAuto false<br/>that day's timeline, anchored"])
  S_OVERDUE(["open · sortDeadline before now (overlay on any plan state)<br/>list: Overdue"])
  S_SEQ(["open · sequenceIndex set (orthogonal flag)<br/>Today's plan section, in order"])
  S_EVENT(["isInformationalEvent true · specificTime<br/>Events tab, timeline, calendar, widget"])
  S_DONE(["isComplete true · completedAt"])
  S_GONE(["row deleted"])
end

