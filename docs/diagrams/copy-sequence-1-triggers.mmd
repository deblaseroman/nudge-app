%% commit ede6774 · stage 1: what starts a writing pass, the throttles checked first, and the arbiter run that follows new copy. The callers of noteShift are a table on the page.
sequenceDiagram
  autonumber
  box rgba(14,111,111,0.10) App code
    participant SCENE as ContentView.swift<br/>onChange(scenePhase)
    participant SHIFT as NudgeCopyService.swift<br/>noteShift
    participant GEN as NudgeCopyService.swift<br/>generateIfNeeded
    participant KEYS as Pass stamps and count<br/>NudgeCopyService.swift
    participant ARB as NudgeArbiter.swift<br/>reevaluate
  end
  SCENE->>GEN: generateIfNeeded
  SHIFT->>GEN: generateIfNeeded
  GEN->>KEYS: read stamps, count
  alt a throttle applies
    GEN-->>SCENE: returns false
  else the pass runs
    GEN->>KEYS: write lastAttempt
    GEN->>KEYS: write day, count
    GEN-->>SCENE: returns true
    SCENE->>ARB: reevaluate
    GEN-->>SHIFT: returns true
    SHIFT->>ARB: reevaluate
  end
