  {
    "id": "cap-study-then-application",
    "kind": "capture",
    "input": {
      "text": "study python tomorrow at 9am and then work on my application"
    },
    "expected": {
      "rowCount": 2,
      "rows": [
        {
          "titleContains": "python",
          "isEvent": false,
          "hasDeadline": false,
          "countdown": false,
          "isOverdue": false,
          "intendedDay": "+1d",
          "plannedStart": "+1d 09:00",
          "estimatedMinutes": 60
        },
        {
          "titleContains": "application",
          "isEvent": false,
          "hasDeadline": false,
          "countdown": false,
          "isOverdue": false
        }
      ]
    },
    "note": "Cycle 2026-09-03-01 addendum: an ordered plan with a stated time keeps the time; intent plus placement, never a countdown or overdue. Caught on device once."
  },
