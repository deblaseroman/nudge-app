  {
    "id": "arb-duesoon-inside-quiet-hours",
    "kind": "arbiter",
    "input": {
      "tasks": [
        {
          "title": "Submit lab report",
          "specificTime": "+1d 07:00"
        }
      ]
    },
    "expected": {
      "tasks": [
        {
          "title": "Submit lab report",
          "candidates": {
            "dueSoon": true
          },
          "scheduled": {
            "dueSoon": true
          },
          "fireAt": {
            "dueSoon": "+1d 05:00"
          }
        }
      ]
    },
    "note": "Design decision, standing since Aug 1 2026 (cycle 2026-08-01-03, restated by Roman Sep 23): a candidate anchored to a set time, an event start or a task due time, fires at its lead time regardless of quiet hours. That is the only way anything fires inside the window; the per-kind toggle is the opt-out. A 7:00 deadline's 5:00 reminder lands inside the fixture's 22:00 to 08:30 quiet window and is scheduled anyway."
  },
