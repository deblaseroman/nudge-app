  {
    "id": "arb-yesterday-placement-rollover",
    "kind": "arbiter",
    "input": {
      "tasks": [
        {
          "title": "Read chapter 4",
          "intendedDate": "-1d",
          "plannedStartDate": "-1d 19:00",
          "estimatedMinutes": 45
        }
      ],
      "rolloverSweep": true
    },
    "expected": {
      "tasks": [
        {
          "title": "Read chapter 4",
          "plannedStart": null,
          "skipCount": 1,
          "intendedDay": "today",
          "isSkipped": false,
          "isOverdue": false,
          "countdown": false,
          "candidates": {
            "placementLead": false
          }
        }
      ]
    },
    "note": "A manual placement whose day passed unstarted: the sweep clears it, and the first skip re-intends it for today (Roman's Skipped rule, Sep 16 2026). Floater membership is not asserted: it depends on the time of day the run happens."
  },
