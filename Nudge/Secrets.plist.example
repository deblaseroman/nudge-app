<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template for Secrets.plist. Copy this file to Secrets.plist (which is
  gitignored) and paste your Anthropic API key into the ANTHROPIC_API_KEY
  value. Secrets.plist must be a member of the Nudge target so the file
  ends up in the app bundle at runtime.

  After copying:
    1. Open Xcode → File → Add Files to "Nudge"…
    2. Select Nudge/Nudge/Secrets.plist
    3. Make sure the "Nudge" target checkbox is on (Add to targets: Nudge)
    4. Build and run — ClaudeService will read the key automatically.
-->
<plist version="1.0">
<dict>
	<key>ANTHROPIC_API_KEY</key>
	<string>sk-ant-api03-PASTE_YOUR_KEY_HERE</string>
</dict>
</plist>
